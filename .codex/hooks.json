{
  "description": "Codex adapter for shared project completion gates.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/pretool_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking shared command policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/client_completion_gate.sh\" check-if-marked-complete",
            "timeout": 30,
            "statusMessage": "Checking shared completion evidence"
          }
        ]
      }
    ]
  }
}
