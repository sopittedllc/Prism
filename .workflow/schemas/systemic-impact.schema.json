{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "symptom", "semantic_role", "authority", "searches", "included_consumers", "excluded_consumers", "system_changes", "representative_tests", "regression_prevention"],
  "properties": {
    "task_id": {"type": "string"},
    "symptom": {"type": "string"},
    "semantic_role": {"type": "string"},
    "authority": {"type": "string"},
    "searches": {"type": "array", "minItems": 1},
    "included_consumers": {"type": "array"},
    "excluded_consumers": {"type": "array", "items": {"type": "object", "required": ["consumer", "reason"]}},
    "system_changes": {"type": "array", "minItems": 1},
    "representative_tests": {"type": "array", "minItems": 1},
    "regression_prevention": {"type": "array", "minItems": 1},
    "knowledge_updates": {"type": "array"}
  }
}
