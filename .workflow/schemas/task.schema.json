{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "task_id", "title", "risk_tier", "state", "base_revision", "acceptance_criteria", "gates"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "title": {"type": "string", "minLength": 3},
    "risk_tier": {"type": "integer", "minimum": 0, "maximum": 3},
    "state": {"enum": ["framing", "research", "planning", "implementation", "verification", "repair", "blocked", "complete"]},
    "base_revision": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "current_revision": {"type": "string"},
    "product_decisions_needed": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "status"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string", "minLength": 3},
          "status": {"enum": ["pending", "passed", "failed", "blocked"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["pending", "passed", "failed", "blocked", "not_applicable"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "revision": {"type": "string"},
          "agent": {"type": "string"}
        }
      }
    },
    "repair_attempts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
