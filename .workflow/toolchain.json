{
  "version": 1,
  "ci_checks": [
    "build-debug",
    "unit-tests",
    "integration-tests",
    "template-integrity",
    "adapter-integrity",
    "catalog-state"
  ],
  "checks": {
    "build-debug": {
      "argv": [
        "swift",
        "build"
      ],
      "timeout_seconds": 600
    },
    "build-release": {
      "argv": [
        "swift",
        "build",
        "-c",
        "release"
      ],
      "timeout_seconds": 600
    },
    "unit-tests": {
      "argv": [
        "swift",
        "test"
      ],
      "timeout_seconds": 600
    },
    "integration-tests": {
      "argv": [
        "python3",
        "scripts/probe_smoke.py"
      ],
      "timeout_seconds": 600
    },
    "template-integrity": {
      "argv": [
        "python3",
        "scripts/template_self_test.py"
      ],
      "timeout_seconds": 600
    },
    "adapter-integrity": {
      "argv": [
        "python3",
        "scripts/sync_agent_adapters.py",
        "--check"
      ],
      "timeout_seconds": 600
    },
    "runtime-tests": {
      "argv": [
        "python3",
        "scripts/probe_runtime.py"
      ],
      "timeout_seconds": 600
    },
    "catalog-state": {
      "argv": [
        "python3",
        "scripts/catalog_state_check.py"
      ],
      "timeout_seconds": 60
    },
    "app-package": {
      "argv": [
        "python3",
        "scripts/build_app.py"
      ],
      "timeout_seconds": 60
    },
    "catalog-runtime": {
      "argv": [
        "build/Prism.app/Contents/MacOS/Prism",
        "--ui-smoke",
        "captures/catalog"
      ],
      "timeout_seconds": 180
    },
    "product-tag-sources": {
      "argv": [
        ".build/debug/simplify-probe",
        "--check-product-tags"
      ],
      "timeout_seconds": 300
    },
    "receipt-binding-runtime": {
      "argv": [
        "env",
        "PRISM_RECEIPT_BINDING_RUNTIME=1",
        "swift",
        "test",
        "--filter",
        "nativeReceiptBindingRuntime"
      ],
      "timeout_seconds": 120
    },
    "automatic-receipt-runtime": {
      "argv": [
        "env",
        "PRISM_AUTOMATIC_RECEIPT_RUNTIME=1",
        "swift",
        "test",
        "--filter",
        "nativeAutomaticReceiptRuntime"
      ],
      "timeout_seconds": 300
    },
    "live-usage-runtime": {
      "argv": [
        "env",
        "PRISM_LIVE_USAGE_RUNTIME=1",
        "swift",
        "test",
        "--filter",
        "nativeLiveCompletedRestoreRuntime"
      ],
      "timeout_seconds": 120
    },
    "protools-restore-v2-runtime": {
      "argv": [
        "env",
        "PRISM_PROTOOLS_RESTORE_V2_RUNTIME=1",
        "swift",
        "test",
        "--filter",
        "nativeProToolsRestoreV2Runtime"
      ],
      "timeout_seconds": 300
    },
    "cubase-native-restore-runtime": {
      "argv": [
        "env",
        "PRISM_CUBASE_NATIVE_RESTORE_RUNTIME=1",
        "swift",
        "test",
        "--filter",
        "nativeCubaseRestoreRuntime"
      ],
      "timeout_seconds": 300
    }
  }
}
