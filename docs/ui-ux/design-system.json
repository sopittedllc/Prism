{
  "$schema": "../../.workflow/schemas/design-system.schema.json",
  "version": 1,
  "status": "proposed",
  "foundations": {
    "typography": {
      "collection_title": "26 semibold",
      "setup_title": "28 bold",
      "inspector_title": "17 semibold",
      "body": "12\u201313 system",
      "eyebrow": "10 semibold",
      "caption": "11 system"
    },
    "color_material": {
      "sidebar": "native sidebar material",
      "content": "semantic window/control background",
      "accent": "Projector pink RGB 1,0.2,0.55; selection uses 14% tint",
      "text": "labelColor / secondaryLabelColor"
    },
    "spacing_grid": {
      "base": 4,
      "content_inset": 24,
      "sidebar_inset": 16,
      "inspector_inset": 22,
      "setup_inset": 30,
      "table_cell_horizontal": 8,
      "navigation_content_horizontal": 10
    },
    "shape_border": {
      "panels": 8,
      "selection": 8
    },
    "motion": {
      "navigation": "immediate; native sheets only"
    },
    "iconography": {
      "brand": "Exact supplied JPG retained as Resources/AppIcon.jpg; deterministic PNG and ICNS conversion; original PNG retained for provenance",
      "controls": "SF Symbols with text names"
    },
    "layering": {
      "structure": "sidebar / collection / contextual inspector",
      "setup": "native sheet"
    },
    "control_target_size": {
      "sidebar_row": 38,
      "table_row": 38,
      "actions": "native controls"
    },
    "numeric_unit_formatting": {
      "counts": "localized formatted integers",
      "size": "ByteCountFormatter for measured plugin-bundle logical bytes; grouped totals require every installation measured. Partial/Unknown groups disclose only qualified known subtotals. Library footprint remains Not measured; instrument storage is Shared with library.",
      "recency": "project modification date proxy; samples only",
      "installer_record": "Plugin installer history appears in inspector/per-format details, independent of Date added and Last used.",
      "addition_bounds": "Plugin Date added uses exact Finder file-location Date Added metadata and shows the earliest available current format date, with source disclosed in Details. It is not an installation claim. Confirmed original addition remains a fallback when Finder metadata is absent; scan, birth, modification, receipt, and use dates never substitute. Other categories use confirmed original addition. Unknown dates sort last; instruments never inherit library/player dates."
    }
  },
  "components": [
    {
      "semantic_role": "collection shell",
      "authority": "CatalogWindow.swift / SetupWindow.swift / CatalogTheme.swift",
      "states": [
        "empty",
        "loading",
        "populated",
        "no match",
        "issues"
      ],
      "examples": [
        "Plugins",
        "Samples",
        "Libraries"
      ],
      "tests": [
        "catalog-runtime",
        "unit-tests",
        "catalog-state"
      ]
    },
    {
      "semantic_role": "inspector",
      "authority": "CatalogWindow.swift / SetupWindow.swift / CatalogTheme.swift",
      "states": [
        "no selection",
        "sample provenance",
        "unavailable references"
      ],
      "examples": [
        "sample-reference-light",
        "libraries-dark"
      ],
      "tests": [
        "catalog-runtime",
        "unit-tests",
        "catalog-state"
      ]
    },
    {
      "semantic_role": "setup",
      "authority": "CatalogWindow.swift / SetupWindow.swift / CatalogTheme.swift",
      "states": [
        "first launch",
        "back",
        "skip",
        "draft edit",
        "accepted",
        "save failure"
      ],
      "examples": [
        "setup-welcome",
        "setup-mixed",
        "setup-long-folders",
        "setup-save-error"
      ],
      "tests": [
        "catalog-runtime",
        "unit-tests",
        "catalog-state"
      ]
    },
    {
      "semantic_role": "identity",
      "authority": "CatalogWindow.swift / SetupWindow.swift / CatalogTheme.swift",
      "states": [
        "light",
        "dark",
        "Dock"
      ],
      "examples": [
        "sidebar",
        "welcome",
        "packaged ICNS"
      ],
      "tests": [
        "catalog-runtime",
        "unit-tests",
        "catalog-state"
      ]
    },
    {
      "semantic_role": "scan progress",
      "authority": "ScanProgress / CatalogWindow.refreshProgress",
      "states": [
        "discovering indeterminate",
        "reading determinate",
        "matching determinate",
        "finished with retained issues"
      ],
      "examples": [
        "loading-light",
        "reading-progress"
      ],
      "tests": [
        "progressHasRealPhaseTotalsAndPreservesResults",
        "progressCompletesEmptyUnavailableAndTruncatedScansHonestly",
        "native smoke"
      ]
    },
    {
      "semantic_role": "plugin format management",
      "authority": "PluginFormatsWindow / PluginProduct / PluginRemoval",
      "states": [
        "keep by default",
        "selected review",
        "all review",
        "cancel",
        "partial failure",
        "success",
        "long paths"
      ],
      "examples": [
        "plugin-formats-dark",
        "plugin-removal-review",
        "plugin-removal-result"
      ],
      "tests": [
        "core identity and grouping",
        "native synthetic Trash",
        "catalog stale review rejection"
      ]
    },
    {
      "semantic_role": "hierarchical collection",
      "authority": "CatalogOutline / CatalogOutlineState / CatalogWindow NSOutlineView / CatalogCell",
      "states": [
        "maker and root expanded",
        "library and folder collapsed",
        "selected instrument",
        "contextual search",
        "metadata-only match",
        "flat sample search",
        "restored browse",
        "offline stale"
      ],
      "examples": [
        "Libraries maker/product/instrument",
        "Individual Samples root/directory/file",
        "Plugins product leaves"
      ],
      "tests": [
        "CatalogOutlineTests",
        "catalog-runtime",
        "catalog-state"
      ]
    },
    {
      "semantic_role": "names and tags search with header sorting",
      "authority": "CatalogWindow.swift / CatalogModel.swift / MusicalMetadata.swift",
      "states": [
        "plain search",
        "zero matches",
        "ascending and descending headers",
        "unknown dates",
        "offline retained record"
      ],
      "examples": [
        "composer-facet-light",
        "simple-browsing-inspector",
        "simple-browsing-dark"
      ],
      "tests": [
        "catalog-runtime",
        "unit-tests",
        "catalog-state"
      ]
    },
    {
      "semantic_role": "musical metadata editor",
      "authority": "MetadataEditor.swift / MusicalMetadata.swift",
      "states": [
        "suggested",
        "user edited",
        "empty suppression",
        "invalid input",
        "save failed draft retained",
        "saved",
        "cancelled",
        "undo"
      ],
      "examples": [
        "composer-metadata-editor",
        "composer-metadata-save-error",
        "composer-sample-validation"
      ],
      "tests": [
        "catalog-runtime",
        "unit-tests",
        "catalog-state"
      ]
    },
    {
      "semantic_role": "direct tag pills and compact setup",
      "authority": "TagPills.swift / SetupWindow.swift",
      "states": [
        "light and dark",
        "hover and keyboard delete",
        "empty plus",
        "wrapped scrolling tags",
        "add draft validation and retry",
        "atomic grouped edit and Undo",
        "single native locations sheet",
        "setup save recovery"
      ],
      "examples": [
        "tag-pill-add",
        "tag-pills-keyboard",
        "setup-welcome",
        "setup-mixed",
        "setup-long-folders",
        "setup-save-error"
      ],
      "tests": [
        "catalog-runtime",
        "unit-tests",
        "catalog-state"
      ]
    }
  ],
  "patterns": [
    "Persistent category navigation; collection-specific evidence columns",
    "Local interactive setup with draft/cancel semantics and explicit first scan",
    "Full selectable paths and per-format Finder actions live in Location; tags and lifecycle facts lead the inspector",
    "No numeric cleanup/savings claims from incomplete evidence",
    "Table text is centered vertically inside 38pt rows with 8pt horizontal inset.",
    "Setup uses one native Type/Folder table; selected removal retains list focus.",
    "Stream inventory before project analysis; pending references remain explicit. Determinate progress has no animation lag.",
    "Native outline uses 16pt indentation with the shared 38pt row and 8pt text inset.",
    "Search keeps matching patch ancestors; flat sample results show a root-relative breadcrumb and distinguish equal root names.",
    "Unmeasured library footprint remains Not measured; instrument storage is Shared with library.",
    "Tag dropdowns and Last used occupy separate rows. Unknown usage is not inactivity; unavailable age ranges remain disabled.",
    "Settings appearance uses native popup Light/Dark/Match system preference; Light default, live preview, Cancel rollback, atomic Save without scan; app-wide semantic colors.",
    "Scan targets the captured active section; plugin formats form the name subtitle with no duplicate format column; standard plugin roots automatic; one Settings entry for preferences."
  ],
  "exceptions": [
    {
      "exception": "macOS13 and Intel not exercised",
      "reason": "Only current Apple Silicon host available",
      "removal_condition": "Run representative target matrix"
    },
    {
      "exception": "VoiceOver human navigation not certified",
      "reason": "Structural labels and keyboard tested only",
      "removal_condition": "VoiceOver user validation"
    }
  ]
}
